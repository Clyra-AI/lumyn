{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "control_id",
    "owner",
    "autonomy_level",
    "mission_paused",
    "mission_canceled",
    "disabled_adapters",
    "max_token_budget",
    "max_write_scope_paths",
    "release_freeze",
    "rollback_route",
    "hotfix_route",
    "launch_request",
    "conflict_behavior",
    "created_at"
  ],
  "properties": {
    "control_id": {"type": "string"},
    "owner": {"type": "string"},
    "autonomy_level": {"type": "string", "enum": ["disabled", "read_only", "restricted", "standard", "trusted"]},
    "mission_paused": {"type": "boolean"},
    "mission_canceled": {"type": "boolean"},
    "disabled_adapters": {"type": "array", "items": {"type": "string"}},
    "max_token_budget": {"type": "integer"},
    "max_write_scope_paths": {"type": "array", "items": {"type": "string"}},
    "release_freeze": {
      "type": "object",
      "required": ["enabled", "reason", "exception_ref"],
      "properties": {
        "enabled": {"type": "boolean"},
        "reason": {"type": "string"},
        "exception_ref": {"type": "string"}
      },
      "additionalProperties": true
    },
    "rollback_route": {
      "type": "object",
      "required": ["strategy", "owner", "artifact_refs"],
      "properties": {
        "strategy": {"type": "string"},
        "owner": {"type": "string"},
        "artifact_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "hotfix_route": {
      "type": "object",
      "required": ["strategy", "owner", "artifact_refs"],
      "properties": {
        "strategy": {"type": "string"},
        "owner": {"type": "string"},
        "artifact_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "launch_request": {
      "type": "object",
      "required": ["requested_action", "requested_write_paths", "requested_adapter", "expected_decision", "reason_code"],
      "properties": {
        "requested_action": {"type": "string", "enum": ["start_mission", "continue_mission", "rollback", "hotfix"]},
        "requested_write_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "requested_adapter": {"type": "string"},
        "expected_decision": {"type": "string", "enum": ["allow", "block", "escalate"]},
        "reason_code": {"type": "string"}
      },
      "additionalProperties": true
    },
    "conflict_behavior": {"type": "string", "enum": ["fail_closed"]},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
