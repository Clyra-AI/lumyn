{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumyn.local/lumyn.impact_report.schema.json",
  "title": "ImpactReport",
  "description": "A read-only, evidence-bound impact classification for one integration graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "report_id",
    "report_digest",
    "generated_at",
    "event_id",
    "contract_digest",
    "installation_id",
    "authorization_snapshot_digest",
    "repository_base",
    "integration_graph_id",
    "integration_graph_digest",
    "analysis_mode",
    "mutation_observed",
    "overall_status",
    "findings",
    "coverage",
    "residual_risks"
  ],
  "properties": {
    "object_type": { "const": "lumyn.impact_report" },
    "schema_version": { "const": "1.0" },
    "report_id": { "$ref": "#/$defs/id" },
    "report_digest": { "$ref": "#/$defs/digest" },
    "generated_at": { "type": "string", "format": "date-time" },
    "event_id": { "$ref": "#/$defs/id" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "installation_id": { "$ref": "#/$defs/id" },
    "authorization_snapshot_digest": { "$ref": "#/$defs/digest" },
    "repository_base": { "$ref": "#/$defs/gitDigest" },
    "integration_graph_id": { "$ref": "#/$defs/id" },
    "integration_graph_digest": { "$ref": "#/$defs/digest" },
    "analysis_mode": { "const": "read_only" },
    "mutation_observed": { "const": false },
    "overall_status": { "$ref": "#/$defs/impactStatus" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/finding" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "residual_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/risk" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "overall_status": { "const": "unaffected" } }, "required": ["overall_status"] },
      "then": {
        "properties": {
          "findings": { "items": { "properties": { "status": { "const": "unaffected" } }, "required": ["status"] } },
          "coverage": {
            "properties": {
              "uncertainty_refs": { "maxItems": 0 },
              "unsupported_scope": { "maxItems": 0 },
              "limitations": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "overall_status": { "const": "uncertain" } }, "required": ["overall_status"] },
      "then": { "properties": { "coverage": { "properties": { "uncertainty_refs": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "overall_status": { "const": "unsupported" } }, "required": ["overall_status"] },
      "then": { "properties": { "coverage": { "properties": { "unsupported_scope": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "overall_status": { "const": "affected_needs_input" } }, "required": ["overall_status"] },
      "then": { "properties": { "findings": { "contains": { "properties": { "status": { "const": "affected_needs_input" } }, "required": ["status"] } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitDigest": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "[?*\\\\]" }
        ]
      }
    },
    "impactStatus": {
      "type": "string",
      "enum": ["unaffected", "affected_supported", "affected_needs_input", "unsupported", "uncertain"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "graph_node_ids",
        "change_item_id",
        "status",
        "path",
        "reason",
        "evidence_refs",
        "uncertainty_refs"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/id" },
        "graph_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "change_item_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/impactStatus" },
        "path": { "$ref": "#/$defs/relativePath" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "uncertainty_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["affected_needs_input", "unsupported", "uncertain"] } }, "required": ["status"] },
          "then": { "properties": { "uncertainty_refs": { "minItems": 1 } } },
          "else": { "properties": { "uncertainty_refs": { "maxItems": 0 } } }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "analyzed_paths", "excluded_paths", "unsupported_scope", "uncertainty_refs", "limitations"],
      "properties": {
        "claim": { "const": "authorized_scope_only" },
        "analyzed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "excluded_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "unsupported_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "uncertainty_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "severity", "description", "next_action"],
      "properties": {
        "risk_id": { "$ref": "#/$defs/id" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    }
  }
}
