        },
        "program": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/+:-]+$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "working_directory": {
          "$ref": "#/$defs/relativePath"
        },
        "network_mode": {
          "const": "offline"
        },
        "lifecycle_scripts_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_files",
        "max_changed_lines",
        "max_diff_bytes",
        "max_turns",
        "max_tokens",
        "max_cost_usd",
        "max_duration_seconds",
        "max_attempts"
      ],
      "properties": {
