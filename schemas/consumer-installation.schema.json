          "minimum": 1
        },
        "max_changed_lines": {
          "type": "integer",
          "minimum": 1
        },
        "max_diff_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
