{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumyn.local/lumyn.agent_runner_conformance_result.schema.json",
  "title": "AgentRunnerConformanceResult",
  "description": "Independent qualification evidence for one exact Agent Runner manifest and executable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "result_id",
    "result_digest",
    "created_at",
    "valid_until",
    "verified_by",
    "runner_manifest_id",
    "runner_manifest_digest",
    "adapter",
    "adapter_version",
    "agent_runner_vendor",
    "executable",
    "suite",
    "auth_and_entitlement",
    "actual_model_route",
    "native_configuration_digest",
    "host_isolation_qualification_digest",
    "control_results",
    "test_cases",
    "summary",
    "live_canary",
    "qualification_status",
    "launch_eligible",
    "migration_verification_claim"
  ],
  "properties": {
    "object_type": { "const": "lumyn.agent_runner_conformance_result" },
    "schema_version": { "const": "1.0" },
    "result_id": { "$ref": "#/$defs/id" },
    "result_digest": { "$ref": "#/$defs/digest" },
    "created_at": { "type": "string", "format": "date-time" },
    "valid_until": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "verified_by": { "const": "independent_lumyn_conformance_harness" },
    "runner_manifest_id": { "$ref": "#/$defs/id" },
    "runner_manifest_digest": { "$ref": "#/$defs/digest" },
    "adapter": { "type": "string", "enum": ["codex", "claude_code", "deterministic_fake", "cursor"] },
    "adapter_version": { "type": "string", "minLength": 1 },
    "agent_runner_vendor": { "type": "string", "minLength": 1 },
    "executable": { "$ref": "#/$defs/executable" },
    "suite": { "$ref": "#/$defs/suite" },
    "auth_and_entitlement": { "$ref": "#/$defs/auth" },
    "actual_model_route": { "$ref": "#/$defs/model" },
    "native_configuration_digest": { "$ref": "#/$defs/digest" },
    "host_isolation_qualification_digest": { "$ref": "#/$defs/digest" },
    "control_results": { "$ref": "#/$defs/controlResults" },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/testCase" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "live_canary": { "$ref": "#/$defs/liveCanary" },
    "qualification_status": { "type": "string", "enum": ["passed", "failed", "deferred", "stale"] },
    "launch_eligible": { "type": "boolean" },
    "migration_verification_claim": { "const": "none" }
  },
  "allOf": [
    {
      "if": { "properties": { "qualification_status": { "const": "passed" } }, "required": ["qualification_status"] },
      "then": {
        "properties": {
          "adapter": { "enum": ["codex", "claude_code", "deterministic_fake"] },
          "valid_until": { "type": "string", "format": "date-time" },
          "launch_eligible": { "const": true },
          "control_results": { "$ref": "#/$defs/passingControls" },
          "test_cases": {
            "items": {
              "properties": {
                "status": { "const": "passed" }
              }
            }
          },
          "summary": { "properties": { "passed": { "minimum": 1 }, "failed": { "const": 0 }, "blocked": { "const": 0 } } },
          "live_canary": {
            "properties": {
              "approved": { "const": true },
              "status": { "const": "passed" },
              "evidence_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "qualification_status": { "enum": ["failed", "deferred", "stale"] } }, "required": ["qualification_status"] },
      "then": { "properties": { "launch_eligible": { "const": false } } }
    },
    {
      "if": { "properties": { "adapter": { "const": "cursor" } }, "required": ["adapter"] },
      "then": {
        "properties": {
          "qualification_status": { "const": "deferred" },
          "launch_eligible": { "const": false },
          "valid_until": { "type": "null" },
          "live_canary": { "properties": { "approved": { "const": false }, "status": { "enum": ["not_run", "deferred"] } } }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "absolutePath": {
      "type": "string",
      "pattern": "^/.+$",
      "not": { "pattern": "^/(repo|workspace)(/|$)|/(node_modules|vendor)/" }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "source_type", "source_uri", "digest", "repository_path_shadowing_rejected"],
      "properties": {
        "canonical_path": { "$ref": "#/$defs/absolutePath" },
        "source_type": { "type": "string", "enum": ["vendor_signed_release", "pinned_package", "lumyn_test_fixture"] },
        "source_uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "repository_path_shadowing_rejected": { "const": true }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "version", "digest"],
      "properties": {
        "suite_id": { "const": "lumyn.agent_runner_conformance" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_mode", "entitlement_class", "noninteractive_automation_allowed", "secret_or_account_value_recorded"],
      "properties": {
        "auth_mode": { "type": "string", "enum": ["consumer_account", "consumer_api_key", "local_runtime", "task_scoped_broker"] },
        "entitlement_class": { "type": "string", "minLength": 1 },
        "noninteractive_automation_allowed": { "const": true },
        "secret_or_account_value_recorded": { "const": false }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_provider", "endpoint", "model_route", "model_version", "opaque", "mutable_mid_run"],
      "properties": {
        "model_provider": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "minLength": 1 },
        "model_route": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "opaque": { "const": false },
        "mutable_mid_run": { "const": false }
      }
    },
    "controlResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_executable",
        "clean_ephemeral_session",
        "neutral_home_and_config",
        "repository_path_shadowing_rejected",
        "noninteractive_model_identity",
        "structured_lifecycle",
        "malformed_output_fail_closed",
        "cancellation_fail_closed",
        "native_configuration_disclosed",
        "executable_extensions_prohibited",
        "host_isolation_enforced",
        "resource_exhaustion_fail_closed",
        "silent_fallback_rejected",
        "self_approval_rejected",
        "self_verification_rejected",
        "remote_delivery_rejected"
      ],
      "properties": {
        "canonical_executable": { "type": "boolean" },
        "clean_ephemeral_session": { "type": "boolean" },
        "neutral_home_and_config": { "type": "boolean" },
        "repository_path_shadowing_rejected": { "type": "boolean" },
        "noninteractive_model_identity": { "type": "boolean" },
        "structured_lifecycle": { "type": "boolean" },
        "malformed_output_fail_closed": { "type": "boolean" },
        "cancellation_fail_closed": { "type": "boolean" },
        "native_configuration_disclosed": { "type": "boolean" },
        "executable_extensions_prohibited": { "type": "boolean" },
        "host_isolation_enforced": { "type": "boolean" },
        "resource_exhaustion_fail_closed": { "type": "boolean" },
        "silent_fallback_rejected": { "type": "boolean" },
        "self_approval_rejected": { "type": "boolean" },
        "self_verification_rejected": { "type": "boolean" },
        "remote_delivery_rejected": { "type": "boolean" }
      }
    },
    "passingControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_executable",
        "clean_ephemeral_session",
        "neutral_home_and_config",
        "repository_path_shadowing_rejected",
        "noninteractive_model_identity",
        "structured_lifecycle",
        "malformed_output_fail_closed",
        "cancellation_fail_closed",
        "native_configuration_disclosed",
        "executable_extensions_prohibited",
        "host_isolation_enforced",
        "resource_exhaustion_fail_closed",
        "silent_fallback_rejected",
        "self_approval_rejected",
        "self_verification_rejected",
        "remote_delivery_rejected"
      ],
      "properties": {
        "canonical_executable": { "const": true },
        "clean_ephemeral_session": { "const": true },
        "neutral_home_and_config": { "const": true },
        "repository_path_shadowing_rejected": { "const": true },
        "noninteractive_model_identity": { "const": true },
        "structured_lifecycle": { "const": true },
        "malformed_output_fail_closed": { "const": true },
        "cancellation_fail_closed": { "const": true },
        "native_configuration_disclosed": { "const": true },
        "executable_extensions_prohibited": { "const": true },
        "host_isolation_enforced": { "const": true },
        "resource_exhaustion_fail_closed": { "const": true },
        "silent_fallback_rejected": { "const": true },
        "self_approval_rejected": { "const": true },
        "self_verification_rejected": { "const": true },
        "remote_delivery_rejected": { "const": true }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "evidence_digest"],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "blocked"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "liveCanary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "status", "evidence_digest"],
      "properties": {
        "approved": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "failed", "not_run", "deferred"] },
        "evidence_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    }
  }
}
