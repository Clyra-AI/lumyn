{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumyn.local/lumyn.migration_pack.schema.json",
  "title": "Provider Change Contract (migration-pack)",
  "description": "Declarative, provider-confirmed API or SDK change intent. This artifact never grants consumer execution authority.",
  "type": "object",
  "required": [
    "object_type",
    "schema_version",
    "migration_pack_id",
    "contract_version",
    "contract_digest",
    "api_provider_id",
    "api_or_sdk",
    "source_version",
    "target_version",
    "audience",
    "semantic_changes",
    "ambiguities",
    "unsupported_cases",
    "verification_guidance",
    "provenance",
    "provider_confirmation",
    "lifecycle",
    "non_executable",
    "grants_consumer_authority",
    "production_credentials_allowed",
    "production_mutation_allowed"
  ],
  "properties": {
    "object_type": {
      "const": "lumyn.migration_pack"
    },
    "schema_version": {
      "const": "1.0"
    },
    "migration_pack_id": {
      "$ref": "#/$defs/stableId"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_digest": {
      "$ref": "#/$defs/sha256"
    },
    "api_provider_id": {
      "$ref": "#/$defs/stableId"
    },
    "api_or_sdk": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "package"
      ],
      "properties": {
        "kind": {
          "enum": [
            "api",
            "sdk"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "package": {
          "type": "string",
          "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$"
        }
      },
      "additionalProperties": false
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "target_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "audience": {
      "type": "object",
      "required": [
        "audience_id",
        "package_version_selector"
      ],
      "properties": {
        "audience_id": {
          "$ref": "#/$defs/stableId"
        },
        "package_version_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "semantic_changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "kind",
          "source_symbol",
          "target_symbol",
          "intent",
          "applicability",
          "mapping"
        ],
        "properties": {
          "change_id": {
            "$ref": "#/$defs/stableId"
          },
          "kind": {
            "enum": [
              "rename",
              "signature_change",
              "request_shape_change",
              "response_shape_change",
              "endpoint_change",
              "behavior_change",
              "removal"
            ]
          },
          "source_symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "target_symbol": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "applicability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "mapping": {
            "type": "object",
            "required": [
              "mode",
              "declarative_steps"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "exact",
                  "repository_specific_reasoning",
                  "manual_input_required"
                ]
              },
              "declarative_steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ambiguity_id",
          "description",
          "required_resolution"
        ],
        "properties": {
          "ambiguity_id": {
            "$ref": "#/$defs/stableId"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "required_resolution": {
            "enum": [
              "provider_clarification",
              "consumer_business_input",
              "unsupported"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "unsupported_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "description",
          "reason"
        ],
        "properties": {
          "case_id": {
            "$ref": "#/$defs/stableId"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    },
    "verification_guidance": {
      "type": "object",
      "required": [
        "required_behaviors",
        "provider_commands_allowed"
      ],
      "properties": {
        "required_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "provider_commands_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "class",
        "source_urls",
        "source_digests",
        "normalized_at"
      ],
      "properties": {
        "class": {
          "enum": [
            "public_derived",
            "provider_confirmed"
          ]
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/httpsUrl"
          }
        },
        "source_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "normalized_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "provider_confirmation": {
      "type": "object",
      "required": [
        "status",
        "provider_operator_id",
        "confirmed_contract_digest",
        "confirmed_at"
      ],
      "properties": {
        "status": {
          "const": "provider_confirmed"
        },
        "provider_operator_id": {
          "$ref": "#/$defs/stableId"
        },
        "confirmed_contract_digest": {
          "$ref": "#/$defs/sha256"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state",
        "superseded_by",
        "withdrawal_reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "superseded",
            "withdrawn"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "withdrawal_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "superseded_by": {
                "type": "null"
              },
              "withdrawal_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "superseded"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "superseded_by": {
                "$ref": "#/$defs/stableId"
              },
              "withdrawal_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "withdrawn"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "superseded_by": {
                "type": "null"
              },
              "withdrawal_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "non_executable": {
      "const": true
    },
    "grants_consumer_authority": {
      "const": false
    },
    "production_credentials_allowed": {
      "const": false
    },
    "production_mutation_allowed": {
      "const": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
