{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumyn.local/lumyn.managed_credential_grant.schema.json",
  "title": "Managed Credential Grant",
  "description": "One-time, attempt-scoped broker grant for provider-sponsored Lumyn-managed agent execution.",
  "type": "object",
  "required": [
    "object_type",
    "schema_version",
    "grant_id",
    "grant_digest",
    "mode",
    "campaign_sponsor",
    "approved_broker",
    "credential_owner_role",
    "usage_billing_owner_role",
    "api_consumer_organization_id",
    "consumer_consent_binding",
    "audience",
    "issued_at",
    "expires_at",
    "ttl_seconds",
    "redemption",
    "hard_quotas",
    "enforcement",
    "revocation",
    "usage_reconciliation",
    "reusable_source_credential_persisted",
    "credential_material_persisted",
    "api_provider_access",
    "production_credential"
  ],
  "properties": {
    "object_type": {
      "const": "lumyn.managed_credential_grant"
    },
    "schema_version": {
      "const": "1.0"
    },
    "grant_id": {
      "$ref": "#/$defs/stableId"
    },
    "grant_digest": {
      "$ref": "#/$defs/sha256"
    },
    "mode": {
      "const": "provider_sponsored_lumyn_managed"
    },
    "campaign_sponsor": {
      "type": "object",
      "required": [
        "role",
        "api_provider_id",
        "grants_execution_authority"
      ],
      "properties": {
        "role": {
          "const": "api_provider"
        },
        "api_provider_id": {
          "$ref": "#/$defs/stableId"
        },
        "grants_execution_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "approved_broker": {
      "type": "object",
      "required": [
        "issuer_id",
        "issuer_role",
        "broker_version",
        "qualification_digest"
      ],
      "properties": {
        "issuer_id": {
          "$ref": "#/$defs/stableId"
        },
        "issuer_role": {
          "const": "lumyn_operator"
        },
        "broker_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "qualification_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "credential_owner_role": {
      "const": "lumyn_operator"
    },
    "usage_billing_owner_role": {
      "const": "lumyn_operator"
    },
    "api_consumer_organization_id": {
      "$ref": "#/$defs/stableId"
    },
    "consumer_consent_binding": {
      "type": "object",
      "required": [
        "authorization_id",
        "authorization_digest",
        "consented_by_role",
        "revocable"
      ],
      "properties": {
        "authorization_id": {
          "$ref": "#/$defs/stableId"
        },
        "authorization_digest": {
          "$ref": "#/$defs/sha256"
        },
        "consented_by_role": {
          "const": "consumer_maintainer"
        },
        "revocable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": [
        "installation_id",
        "installation_digest",
        "event_id",
        "event_digest",
        "plan_id",
        "plan_digest",
        "attempt_id",
        "agent_runner_id",
        "agent_runner_digest",
        "model_route_id",
        "model_route_digest"
      ],
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/stableId"
        },
        "installation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "event_id": {
          "$ref": "#/$defs/stableId"
        },
        "event_digest": {
          "$ref": "#/$defs/sha256"
        },
        "plan_id": {
          "$ref": "#/$defs/stableId"
        },
        "plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_id": {
          "$ref": "#/$defs/stableId"
        },
        "agent_runner_id": {
          "$ref": "#/$defs/stableId"
        },
        "agent_runner_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model_route_id": {
          "$ref": "#/$defs/stableId"
        },
        "model_route_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "redemption": {
      "type": "object",
      "required": [
        "mode",
        "one_time",
        "creates_single_attempt_session",
        "multiple_calls_within_attempt_allowed",
        "refresh_allowed",
        "post_attempt_replay_allowed",
        "cross_attempt_reuse_allowed",
        "state",
        "redeemed_at"
      ],
      "properties": {
        "mode": {
          "const": "one_time_into_single_agent_attempt_session"
        },
        "one_time": {
          "const": true
        },
        "creates_single_attempt_session": {
          "const": true
        },
        "multiple_calls_within_attempt_allowed": {
          "const": true
        },
        "refresh_allowed": {
          "const": false
        },
        "post_attempt_replay_allowed": {
          "const": false
        },
        "cross_attempt_reuse_allowed": {
          "const": false
        },
        "state": {
          "enum": [
            "unredeemed",
            "redeemed",
            "revoked",
            "expired"
          ]
        },
        "redeemed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "redeemed"
              }
            }
          },
          "then": {
            "properties": {
              "redeemed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "redeemed_at": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "hard_quotas": {
      "type": "object",
      "required": [
        "max_tokens",
        "max_cost_usd",
        "max_calls"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "object",
      "required": [
        "mode",
        "enforcer_id",
        "enforcement_digest",
        "fail_closed_if_unavailable"
      ],
      "properties": {
        "mode": {
          "enum": [
            "vendor_native_bounded_credential",
            "approved_budget_enforcing_proxy"
          ]
        },
        "enforcer_id": {
          "$ref": "#/$defs/stableId"
        },
        "enforcement_digest": {
          "$ref": "#/$defs/sha256"
        },
        "fail_closed_if_unavailable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "revocation": {
      "type": "object",
      "required": [
        "supported",
        "revocation_handle_digest",
        "revoke_on_attempt_end"
      ],
      "properties": {
        "supported": {
          "const": true
        },
        "revocation_handle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "revoke_on_attempt_end": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "usage_reconciliation": {
      "type": "object",
      "required": [
        "required",
        "reconciliation_id",
        "records_secret_values"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "reconciliation_id": {
          "$ref": "#/$defs/stableId"
        },
        "records_secret_values": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "reusable_source_credential_persisted": {
      "const": false
    },
    "credential_material_persisted": {
      "const": false
    },
    "api_provider_access": {
      "type": "object",
      "required": [
        "credential",
        "source",
        "context",
        "prompt",
        "response",
        "tool_trace",
        "agent_session"
      ],
      "properties": {
        "credential": {
          "const": false
        },
        "source": {
          "const": false
        },
        "context": {
          "const": false
        },
        "prompt": {
          "const": false
        },
        "response": {
          "const": false
        },
        "tool_trace": {
          "const": false
        },
        "agent_session": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "production_credential": {
      "const": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
