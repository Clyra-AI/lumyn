{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumyn.local/lumyn.integration_graph.schema.json",
  "title": "IntegrationGraph",
  "description": "A read-only, scope-honest graph of one authorized consumer repository integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "graph_id",
    "graph_digest",
    "generated_at",
    "event_id",
    "contract_digest",
    "installation_id",
    "authorization_snapshot_digest",
    "repository_base",
    "package_root",
    "analysis_mode",
    "mutation_observed",
    "coverage",
    "nodes",
    "edges"
  ],
  "properties": {
    "object_type": { "const": "lumyn.integration_graph" },
    "schema_version": { "const": "1.0" },
    "graph_id": { "$ref": "#/$defs/id" },
    "graph_digest": { "$ref": "#/$defs/digest" },
    "generated_at": { "type": "string", "format": "date-time" },
    "event_id": { "$ref": "#/$defs/id" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "installation_id": { "$ref": "#/$defs/id" },
    "authorization_snapshot_digest": { "$ref": "#/$defs/digest" },
    "repository_base": { "$ref": "#/$defs/gitDigest" },
    "package_root": { "$ref": "#/$defs/relativePath" },
    "analysis_mode": { "const": "read_only" },
    "mutation_observed": { "const": false },
    "coverage": { "$ref": "#/$defs/coverage" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitDigest": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "[?*\\\\]" }
        ]
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "analyzed_paths",
        "excluded_paths",
        "generated_or_vendored_paths",
        "unsupported_patterns",
        "uncertainties"
      ],
      "properties": {
        "claim": { "const": "authorized_scope_only" },
        "analyzed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "excluded_paths": { "$ref": "#/$defs/stringList" },
        "generated_or_vendored_paths": { "$ref": "#/$defs/stringList" },
        "unsupported_patterns": { "$ref": "#/$defs/stringList" },
        "uncertainties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uncertainty" }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty_id", "kind", "location", "reason", "next_action"],
      "properties": {
        "uncertainty_id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": ["dynamic_usage", "ambiguous_wrapper", "unsupported_syntax", "excluded_scope", "analysis_gap"]
        },
        "location": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "path", "symbol", "analysis_status", "evidence_refs"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": [
            "sdk_dependency",
            "direct_import",
            "aliased_import",
            "wrapper",
            "call_site",
            "data_mapping",
            "configuration",
            "test",
            "mock",
            "cassette",
            "fixture"
          ]
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "symbol": { "type": ["string", "null"] },
        "analysis_status": {
          "type": "string",
          "enum": ["resolved", "affected", "unaffected", "needs_input", "unsupported", "uncertain"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "uncertainty_ref": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "analysis_status": { "enum": ["needs_input", "unsupported", "uncertain"] } },
            "required": ["analysis_status"]
          },
          "then": { "required": ["uncertainty_ref"] },
          "else": { "not": { "required": ["uncertainty_ref"] } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_node_id", "to_node_id", "kind", "confidence", "evidence_refs"],
      "properties": {
        "edge_id": { "$ref": "#/$defs/id" },
        "from_node_id": { "$ref": "#/$defs/id" },
        "to_node_id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": ["imports", "aliases", "wraps", "calls", "maps", "configures", "tests", "mocks", "replays", "uses_fixture"]
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low", "unknown"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
